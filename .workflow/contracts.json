  "runbook_steps": [
    {
      "name": "Verify hosted source authority",
      "command": "git fetch origin main; git switch main; git pull --ff-only; git rev-parse HEAD; git status --porcelain",
      "expected": "Latest maxqstudio/max-trading-agent main exact SHA and clean worktree."
    },
    {
      "name": "Create phase branch",
      "command": "git switch -c work/<semantic-phase-name>",
      "expected": "Work branch descends from latest main; no reset/rewrite of valid work."
    },
    {
      "name": "Python environment",
      "command": "py -3.13 -m venv .venv; .\\.venv\\Scripts\\python.exe -m pip install -r requirements.lock.txt",
      "expected": "Python 3.13 environment with locked dependencies."
    },
    {
      "name": "Frontend dependencies",
      "command": "cd frontend; npm ci; cd ..",
      "expected": "package-lock resolves without required dependency errors."
    },
    {
      "name": "Sync generated governance",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\sync_project_truth.py",
      "expected": "PROJECT_DOCS_SYNC=PASS; commit only deterministic compiler outputs."
    },
    {
      "name": "Validate generated docs",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_project_docs.py",
      "expected": "No stale/missing generated canonical docs."
    },
    {
      "name": "Validate sequence sessions",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_sequence_sessions.py",
      "expected": "Eight current DURING sessions with zero failed sessions."
    },
    {
      "name": "Validate handoff and human comprehension",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_handoff.py; .\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_human_comprehension.py --require-pass",
      "expected": "STRICT handoff and HUMAN_COMPREHENSION PASS."
    },
    {
      "name": "Validate cross-document consistency",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_cross_document_consistency.py",
      "expected": "RESULT=PASS without stale repository/runtime authority conflicts."
    },
    {
      "name": "Validate project truth",
      "command": ".\\.venv\\Scripts\\python.exe .workflow\\tools\\validate_project_truth.py",
      "expected": "RESULT=PASS for the current hosted scope; final real runtime remains explicitly deferred."
    },
    {
      "name": "Backend cumulative tests",
      "command": ".\\.venv\\Scripts\\python.exe -m pytest backend\\tests -q -o addopts=",
      "expected": "At least the verified migration floor of 488 PASS; any unexplained decrease blocks the phase."
    },
    {
      "name": "Python dependencies",
      "command": ".\\.venv\\Scripts\\python.exe -m pip check",
      "expected": "No broken requirements."
    },
    {
      "name": "Frontend tests lint build dependencies",
      "command": "cd frontend; npm test -- --run; npm run lint; npm run build; npm ls --all; cd ..",
      "expected": "At least 53 tests across 10 files, lint PASS, production build PASS, dependency tree exit 0."
    },
    {
      "name": "Public exact-tree secret scan",
      "command": ".\\.venv\\Scripts\\python.exe scripts\\scan_m05_candidate_tree.py --candidate-sha HEAD",
      "expected": "PASS with no plaintext high-confidence secret or forbidden secret-storage path."
    },
    {
      "name": "Hosted phase acceptance",
      "command": "Push work branch and inspect .github/workflows/windows-ci.yml for the exact candidate commit.",
      "expected": "Source-only policy, governance, Skill provenance/selftest, backend, pip, frontend test/lint/build/dependency gates all PASS on windows-latest."
    },
    {
      "name": "Merge and main revalidation",
      "command": "Merge the green phase branch to main, then inspect Windows CI for the resulting main commit.",
      "expected": "Main Windows CI PASS before beginning the next ordinary development phase."
    },
    {
      "name": "Final runtime acceptance boundary",
      "command": "Only after hosted roadmap closure: clean-clone final main and run INSTALL.ps1 on Owner PC before real MT5/MetaEditor/browser/E2E checks.",
      "expected": "OWNER_PC_FINAL_ACCEPTANCE_REQUIRED until that final phase; never infer runtime PASS from GitHub Actions."
    }
  ],
